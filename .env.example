# =====================================================================
# دفء | منصة التبرع بالملابس — Environment variables
# Copy to .env.local for local development, and add the same keys in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
# =====================================================================

# --- Supabase (Project Settings → API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ------------------------------------------------------------
# Public URL of the site (used for password-reset / invite links and SEO).
NEXT_PUBLIC_SITE_URL=https://daff.example.om

# --- Secrets ---------------------------------------------------------
# Long random string (at least 32 characters). Signs donor tracking sessions,
# success-page links and hashes one-time codes / IP addresses.
# Generate with:  openssl rand -base64 48
APP_SECRET=

# --- SMS for donation tracking one-time codes ------------------------
# "twilio"  → sends real SMS through Twilio (fill the TWILIO_* values below)
# "console" → development only: prints the code in the server log
# empty     → tracking page explains that verification is not available yet
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number (+1...) or an approved alphanumeric sender ID (e.g. DAFF)
TWILIO_FROM=

# --- Data retention ----------------------------------------------------
# Personal data of completed/cancelled donations is anonymized after this many days
# when you run `npm run retention` (or the scheduled job described in DEPLOYMENT.md).
RETENTION_DAYS=365
